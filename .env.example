# Copy to .env.local and fill in. Everything here is exposed to the browser.

# --- Supabase (required) -----------------------------------------------------
# Without these the projects, testimonials and partners sections render their
# empty state and the booking form is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site --------------------------------------------------------------------
# Absolute URL of the deployment. Used for metadataBase, canonical URLs,
# Open Graph images, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://al-kayan.com

# --- Company contact details -------------------------------------------------
# Fall back to placeholders when unset. Set these before going live.
NEXT_PUBLIC_COMPANY_PHONE=+966501234567
NEXT_PUBLIC_COMPANY_EMAIL=info@al-kayan.com

# --- Social profiles (optional) ----------------------------------------------
# Leave blank and the corresponding icon is hidden instead of linking nowhere.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
