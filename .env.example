# =============================================================================
# AL-KAYAN — environment variables
# =============================================================================
#
# Copy this file and fill in the values:
#
#     cp .env.example .env.local
#
# Every variable below is prefixed NEXT_PUBLIC_. That is not an oversight: this
# is a static marketing site with no server-side data access, so every value it
# needs is one the browser needs too. But it does mean Next.js inlines these
# into the JavaScript bundle at build time, where anyone can read them.
#
# Therefore:
#   * never put a real secret behind a NEXT_PUBLIC_ name;
#   * never add SUPABASE_SERVICE_ROLE_KEY to this project. Nothing here uses
#     one, and a service-role key bypasses row-level security entirely.
#
# .env.local is git-ignored (see .gitignore: `.env*.local`). THIS file is
# committed, so it must only ever contain placeholders.
#
# Changing any of these requires a rebuild, not just a restart — they are
# compiled in, not read at runtime.
# =============================================================================


# --- Supabase ----------------------------------------------------------------
# Supabase dashboard -> your project -> Project Settings -> API.
#
# Both are safe to expose: the anon key is designed to be public and is only as
# powerful as your row-level security policies allow. See supabase/migrations
# for the policies this project relies on.
#
# Leave them blank and the site still builds and runs: the projects,
# testimonials and partners sections render their empty states and the booking
# form disables itself with an explanatory message rather than crashing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# --- Site --------------------------------------------------------------------
# Absolute URL of this deployment, no trailing slash. Drives metadataBase, the
# canonical tag, Open Graph URLs, sitemap.xml and robots.txt.
#
# Get this wrong in production and search engines will be told the canonical
# home of every page is somewhere else.
NEXT_PUBLIC_SITE_URL=https://al-kayan.com


# --- Company contact details -------------------------------------------------
# One phone number and one email for the entire site: the header call button,
# the mobile call button, the footer, the contact cards, the chat widget, the
# floating WhatsApp button and the JSON-LD all read from these.
#
# The phone must be an Egyptian mobile. lib/site-config.ts formats it for
# display, strips it to digits for tel: and wa.me, and the bookings RLS policy
# in Supabase validates submissions against the same shape
# (^(\+?20|0020|0)?1[0125][0-9]{8}$).
#
# These fall back to placeholders when unset. Set the real values before launch.
NEXT_PUBLIC_COMPANY_PHONE=+201001234567
NEXT_PUBLIC_COMPANY_EMAIL=info@al-kayan.com


# --- Hero background ---------------------------------------------------------
# Optional. Both have working defaults in lib/site-config.ts.
#
# NEXT_PUBLIC_HERO_VIDEO_URL  — the looping hero background. Set it to a local
#   path such as /brand/hero.mp4 to serve the file yourself (recommended for
#   production; see docs/BRAND-ASSETS.md). Set it to an empty string to turn
#   the video off entirely and keep the still.
#
# NEXT_PUBLIC_HERO_POSTER_URL — the still shown before the video is ready and
#   permanently whenever it cannot play (reduced motion, Save-Data, an error,
#   or an autoplay refusal).
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=


# --- Social profiles ---------------------------------------------------------
# Optional. Leave blank and the icon is not rendered at all, rather than
# linking nowhere.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
